<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 底色：更通透的浅黑 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22000000"
                android:endColor="#12000000"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 2. 顶部镜面高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#59FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 3. 底部厚度阴影 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:endColor="#2E000000"
                android:angle="90" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 4. 外沿镜面描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <!-- 5. 内侧细高光 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
